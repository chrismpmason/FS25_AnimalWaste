        <text name="aw_settings_sheepWaste_label"                 text="Sheep &amp; Goat Waste Rate"/>
        <text name="aw_settings_sheepWaste_tooltip"               text="Multiplies manure output on your sheep and goat pastures (goats share this slider), independently of the cow rates. Change applies on the next in-game hour."/>
        <text name="aw_settings_sheepWaste_texts_1"               text="1x"/>
        <text name="aw_settings_sheepWaste_texts_2"               text="5x"/>
